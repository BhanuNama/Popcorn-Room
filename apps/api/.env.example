# Copy to .env and adjust. Defaults below match `livekit-server --dev`.
PORT=8787
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LiveKit (self-hosted SFU or LiveKit Cloud free tier)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Optional: URL for server-side calls if different from LIVEKIT_URL (http/https)
# LIVEKIT_HOST=http://localhost:7880

# Keeps signed identities valid across API restarts (set in production!)
IDENTITY_SECRET=change-me-to-a-long-random-string

# Optional: MongoDB Atlas free tier. Leave empty for in-memory rooms.
MONGODB_URI=

# Optional: GIPHY free API key for GIF search in chat
GIPHY_API_KEY=

TOKEN_TTL=15m
